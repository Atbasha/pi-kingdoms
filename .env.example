# ========================================
# Pi Kingdoms - Environment Configuration
# ========================================

# NODE ENVIRONMENT
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pi_kingdoms_dev
DB_USER=postgres
DB_PASSWORD=dev_password_change_in_prod
DB_SSL=false
DB_POOL_SIZE=20

# PI NETWORK INTEGRATION
# Get these from https://developers.minepi.com/dashboard
PI_API_KEY=your_pi_api_key_here
PI_API_SECRET=your_pi_api_secret_here
PI_WALLET_SERVER_URL=https://api.mainnet.minepi.com
PI_DEVELOPMENT=true

# AUTHENTICATION
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRY=30d

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# EMAIL (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@pikingdoms.dev

# AWS/S3 (For asset storage)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=pi-kingdoms-assets

# REDIS (Caching & Real-time)
REDIS_URL=redis://localhost:6379
REDIS_EXPIRY=3600

# LOGGING
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# GAME SETTINGS
GAME_STARTING_RESOURCES=1000
GAME_MAX_LEVEL=100
GAME_BUILDING_SLOTS=8
GAME_ADVENTURE_CHAPTERS=10
GAME_DAILY_ENERGY_RESET=24

# REWARD SETTINGS
REWARD_DAILY_LOGIN=10
REWARD_QUEST_COMPLETE=25
REWARD_ACHIEVEMENT_UNLOCK=50
REWARD_LEADERBOARD_TOP1=1000
REWARD_LEADERBOARD_TOP10=500
REWARD_LEADERBOARD_TOP100=100

# ADMIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
ADMIN_JWT_EXPIRY=24h

# SECURITY
CSRF_PROTECTION=true
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=true

# MAINTENANCE
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Server maintenance in progress